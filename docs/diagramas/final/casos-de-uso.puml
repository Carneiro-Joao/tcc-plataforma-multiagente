@startuml casos-de-uso
' Único ator: o professor. As APIs de LLM (Gemini e Groq) são serviços externos usados pelos componentes
' de geração e de avaliação e aparecem no diagrama de componentes (decisão do João, 25/11).
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultFontName Arial
actor "Professor" as P
rectangle "AulaIA" {
  usecase "UC01\nGerar plano de aula" as UC01
  usecase "Informar contexto\nda aula" as CTX
  usecase "Confirmar\nhabilidade BNCC" as CONF
  usecase "Escolher habilidade\nno catálogo" as CAT
  usecase "Abrir documento-fonte\nda BNCC" as FONTE
  usecase "Gerar novamente" as NOVA
  usecase "UC02\nVisualizar plano e parecer" as UC02
  usecase "UC03\nAprovar plano" as UC03
  usecase "UC04\nBaixar plano em PDF" as UC04
}
P --> UC01
P --> UC02
P --> UC03
P --> UC04
UC01 .> CTX : <<include>>
UC01 .> CONF : <<include>>
CAT .> UC01 : <<extend>>
FONTE .> UC01 : <<extend>>
NOVA .> UC01 : <<extend>>
@enduml

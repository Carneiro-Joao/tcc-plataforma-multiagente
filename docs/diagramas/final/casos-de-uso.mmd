%% Versão Mermaid do diagrama de casos de uso (equivalente a casos-de-uso.puml, que continua sendo a fonte UML).
%% Mermaid não tem diagrama de casos de uso: atores são nós com forma de pessoa, casos de uso são elipses (estádio),
%% <<include>> e <<extend>> são setas tracejadas rotuladas.
%% Único ator: o professor. As APIs de LLM (Gemini e Groq) ficam no diagrama de componentes (decisão do João, 25/11).
flowchart LR
    P(["👤 Professor"])
    subgraph SIS["AulaIA"]
        direction TB
        UC01(["UC01<br/>Gerar plano de aula"])
        CTX(["Informar contexto<br/>da aula"])
        CONF(["Confirmar<br/>habilidade BNCC"])
        CAT(["Escolher habilidade<br/>no catálogo"])
        FONTE(["Abrir documento-fonte<br/>da BNCC"])
        NOVA(["Gerar novamente"])
        UC02(["UC02<br/>Visualizar plano e parecer"])
        UC03(["UC03<br/>Aprovar plano"])
        UC04(["UC04<br/>Baixar plano em PDF"])
    end
    P --- UC01
    P --- UC02
    P --- UC03
    P --- UC04
    UC01 -.->|"«include»"| CTX
    UC01 -.->|"«include»"| CONF
    CAT -.->|"«extend»"| UC01
    FONTE -.->|"«extend»"| UC01
    NOVA -.->|"«extend»"| UC01
    classDef ator fill:#fbeee2,stroke:#a2561b,color:#16242b
    classDef uc fill:#ffffff,stroke:#16242b,color:#16242b
    classDef ext fill:#f2f5f6,stroke:#5a6a72,color:#16242b
    class P ator
    class UC01,UC02,UC03,UC04 uc
    class CTX,CONF,CAT,FONTE,NOVA ext
